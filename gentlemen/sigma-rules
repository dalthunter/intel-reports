title: Cloudflare Tunnel Client Execution
id: 4fafadcb-7884-4835-b51c-b273bdfa49af
status: experimental
description: >
    Detects the Cloudflare tunnel client (cloudflared) starting a tunnel, matched on
    command-line arguments so renamed copies are still caught. The Gentlemen register
    unauthorized tunnels inside victim environments for covert access and staged
    exfiltration.
references:
    - https://www.microsoft.com/en-us/security/blog/2026/05/28/the-gentlemen-ransomware-dissecting-a-self-propagating-go-encryptor/
author: Dalton Hunter
date: 2026-08-23
modified: 2026-11-03
tags:
    - attack.command-and-control
    - attack.t1572
    - attack.exfiltration
    - attack.t1048
logsource:
    category: process_creation
    product: windows
detection:
    selection_tunnel:
        CommandLine|contains: ' tunnel '
    selection_args:
        CommandLine|contains:
            - ' run'
            - '--token'
            - 'service install'
    condition: selection_tunnel and selection_args
falsepositives:
    - Sanctioned Cloudflare Zero Trust deployments; exclude approved hosts or service accounts
level: high

