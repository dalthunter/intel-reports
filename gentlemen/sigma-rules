title: Shadow Copy or Backup Catalog Deletion
id: 531cfe36-bc78-4428-9254-40e0d136a3f8
status: experimental
description: >
    Detects deletion of volume shadow copies or the Windows backup catalog through
    vssadmin, wmic, wbadmin, or PowerShell, a near-certain precursor to The Gentlemen's
    encryption stage.
references:
    - https://www.microsoft.com/en-us/security/blog/2026/05/28/the-gentlemen-ransomware-dissecting-a-self-propagating-go-encryptor/
author: Dalton Hunter
date: 2026-08-23
modified: 2026-11-03
tags:
    - attack.impact
    - attack.t1490
logsource:
    category: process_creation
    product: windows
detection:
    selection_vssadmin:
        Image|endswith: '\vssadmin.exe'
        CommandLine|contains:
            - 'delete shadows'
            - 'resize shadowstorage'
    selection_wmic:
        Image|endswith: '\wmic.exe'
        CommandLine|contains: 'shadowcopy delete'
    selection_wbadmin:
        Image|endswith: '\wbadmin.exe'
        CommandLine|contains: 'delete catalog'
    selection_ps_img:
        Image|endswith:
            - '\powershell.exe'
            - '\pwsh.exe'
    selection_ps_shadow:
        CommandLine|contains: 'Win32_Shadowcopy'
    selection_ps_delete:
        CommandLine|contains:
            - '.Delete()'
            - 'Remove-WmiObject'
            - 'Remove-CimInstance'
    condition: selection_vssadmin or selection_wmic or selection_wbadmin or (selection_ps_img and selection_ps_shadow and selection_ps_delete)
falsepositives:
    - Backup software managing shadow copy retention; tune by parent process
level: high

