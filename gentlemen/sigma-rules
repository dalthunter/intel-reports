title: Shell Spawned by Erlang/OTP Runtime (CVE-2025-32433)
id: 2267a422-1a33-4e3a-84bf-b2ead9d859b5
status: experimental
description: >
    Detects a Unix shell launched by the Erlang/OTP runtime, the host-side result of
    successful remote code execution through the pre-authentication Erlang/OTP SSH
    flaw used against exposed management infrastructure.
references:
    - https://nvd.nist.gov/vuln/detail/CVE-2025-32433
author: Dalton Hunter
date: 2026-08-23
modified: 2026-11-03
tags:
    - attack.initial-access
    - attack.t1190
    - attack.execution
    - attack.t1059.004
    - cve.2025-32433
logsource:
    category: process_creation
    product: linux
detection:
    selection_parent:
        ParentImage|endswith:
            - '/beam.smp'
            - '/erl_child_setup'
    selection_shell:
        Image|endswith:
            - '/sh'
            - '/bash'
            - '/dash'
            - '/zsh'
    condition: selection_parent and selection_shell
falsepositives:
    - Erlang applications such as RabbitMQ or CouchDB that legitimately run shell commands; baseline per host
level: medium

