title: Large Cryptocurrency Withdrawal Followed by Rapid Mixer/Chain-Hop Activity
id: 8d1e2f3a-4b5c-4d7e-f6a7-9b0c1d2e3f08
status: experimental
description: Detects a high-value cryptocurrency withdrawal followed within a short window by interaction with a known mixing service or rapid cross-chain movement, matching TraderTraitor's post-theft laundering pattern observed after the Bybit and related heists.
author: Dalton Hunter
date: 2026/08/23
references:
    - https://lazarus.day/reports/tradertraitor-the-kings-of-the-crypto-heist-8F1n8/
tags:
    - attack.exfiltration
    - attack.t1657
logsource:
    category: application
    service: blockchain_monitoring
detection:
    selection_large_withdrawal:
        EventType: 'Withdrawal'
        AmountUsd|gt: 500000
    selection_mixer:
        DestinationAddress|contains: 'KNOWN_MIXER_BRIDGE_ADDRESS_LIST'  # populate from current chain-analysis feed
    timeframe: 1h
    condition: selection_large_withdrawal and selection_mixer
falsepositives:
    - Legitimate large institutional withdrawal that independently routes through a bridge for unrelated reasons
level: critical
