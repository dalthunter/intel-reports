id: 4f6a7b8c-9d1e-4f3a-b2c3-5d6e7f8a9b05
status: experimental
description: Detects TLS sessions carrying a payload with high entropy inconsistent with typical HTTP/JSON content, consistent with Lazarus layering additional encryption inside an already-encrypted SSL tunnel.
author: Dalton Hunter
date: 2026/08/23
references:
    - https://attack.mitre.org/techniques/T1071/
tags:
    - attack.command_and_control
    - attack.t1071
    - attack.t1573
logsource:
    category: proxy
detection:
    selection:
        c-uri|contains: 'https://'
    high_entropy_body: HIGH_ENTROPY_PAYLOAD_FLAG  # populate from proxy/IDS entropy scoring feature
    condition: selection and high_entropy_body
falsepositives:
    - Legitimate encrypted-within-encrypted traffic such as VPN-over-HTTPS or certain backup tools
level: low

