id: 4f6a7b8c-9d1e-4f3a-b2c3-5d6e7f8a9b08
status: experimental
description: Detects a large outbound cryptocurrency transfer followed within a short window by interaction with a known mixing service or cross-chain bridge, consistent with Lazarus's rapid post-theft laundering pattern.
author: Dalton Hunter
date: 2026/08/23
references:
    - https://deepstrike.io/blog/lazarus-group
tags:
    - attack.exfiltration
    - attack.t1020
logsource:
    category: application
    service: blockchain_monitoring
detection:
    selection_large_transfer:
        EventType: 'Withdrawal'
        AmountUsd|gt: 100000
    selection_mixer:
        DestinationAddress|contains: 'KNOWN_MIXER_BRIDGE_ADDRESS_LIST'  # populate from current chain-analysis feed
    timeframe: 1h
    condition: selection_large_transfer and selection_mixer
falsepositives:
    - Legitimate large customer withdrawal that independently routes through a bridge for unrelated reasons
level: high
