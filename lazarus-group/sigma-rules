title: Anomalous Multi-Signature Wallet Approval Request
id: 4f6a7b8c-9d1e-4f3a-b2c3-5d6e7f8a9b07
status: experimental
description: Detects a multi-signature wallet transaction approval request originating from an unrecognized signer session or outside normal approval hours, consistent with Lazarus's transaction-manipulation approach to draining exchange or DeFi platform funds.
author: Dalton Hunter
date: 2026/08/23
references:
    - https://www.sanctions.io/blog/the-lazarus-group-and-dprk-crypto-theft-in-2026
tags:
    - attack.impact
    - attack.t1565
logsource:
    category: application
    service: custody_platform
detection:
    selection:
        EventType: 'MultiSigApprovalRequest'
    filter_known_signer:
        SignerSessionId|contains: 'KNOWN_SIGNER_SESSION_LIST'  # populate with registered/approved signer sessions
    condition: selection and not filter_known_signer
falsepositives:
    - New authorized signer onboarded without updating the known-session list
level: high

